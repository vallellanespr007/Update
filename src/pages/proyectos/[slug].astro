---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getProjects, disciplinesText, SECTOR_LABELS, REVIEW } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p, all: projects } }));
}

const { project, all } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const related = all
  .filter((p) => p.id !== project.id && (p.data.sector === d.sector || p.data.disciplines.some((x) => d.disciplines.includes(x))))
  .slice(0, 3);
---
<Base title={`${d.title} — ${d.client}`} description={d.summary} image={d.cover} noindex={d.draft}>
  {REVIEW && d.draft && (
    <aside class="review-box" aria-label="Pendientes para publicar">
      <div class="container">
        <p><span class="badge-draft">Borrador</span> <strong>Este caso no se publicará hasta completar:</strong></p>
        <ul>{d.pending.map((x) => <li>{x}</li>)}</ul>
      </div>
    </aside>
  )}

  <article>
    <header class="p-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Ruta de navegación">
          <a href="/proyectos/">Proyectos</a> <span aria-hidden="true">/</span> <span aria-current="page">{d.client}</span>
        </nav>
        <div class="p-head">
          <h1 class="display p-title">{d.title}</h1>
          <p class="lead">{d.summary}</p>
        </div>
        <dl class="p-facts">
          <div><dt>Cliente</dt><dd>{d.client}</dd></div>
          <div><dt>Sector</dt><dd>{SECTOR_LABELS[d.sector]}</dd></div>
          <div><dt>Disciplina</dt><dd>{disciplinesText(project) || (REVIEW ? 'Por confirmar' : '—')}</dd></div>
        </dl>
      </div>
    </header>

    {d.cover && (
      <div class="container p-cover">
        <Image src={d.cover} alt={d.coverAlt} widths={[800, 1400, 2000]} sizes="(max-width: 1300px) 100vw, 1240px" loading="eager" fetchpriority="high" />
      </div>
    )}

    <section class="section p-body">
      <div class="container p-grid">
        {(d.context || REVIEW) && (
          <div class="p-col">
            <h2 class="p-label">Contexto</h2>
            {d.context ? <p>{d.context}</p> : <p class="pending-field">Pendiente: contexto aprobado</p>}
          </div>
        )}
        {(d.objective || REVIEW) && (
          <div class="p-col">
            <h2 class="p-label">Objetivo</h2>
            {d.objective ? <p>{d.objective}</p> : <p class="pending-field">Pendiente: objetivo aprobado</p>}
          </div>
        )}
        {(d.services.length > 0 || REVIEW) && (
          <div class="p-col">
            <h2 class="p-label">Servicios realizados</h2>
            {d.services.length > 0 ? <ul class="p-services">{d.services.map((s) => <li>{s}</li>)}</ul> : <p class="pending-field">Pendiente: servicios confirmados</p>}
          </div>
        )}
      </div>
      <div class="container p-content"><Content /></div>
    </section>

    {(d.video || d.gallery.length > 0) && (
      <section class="section section--soft p-gallery" aria-labelledby="gal-title">
        <div class="container">
          <h2 id="gal-title" class="h2 gal-title">Entregables</h2>
          <div class="gal-grid">
            {d.video && (
              <figure class="gal-item gal-video">
                <video controls preload="metadata" playsinline poster={d.videoPoster?.src}>
                  <source src={d.video} type="video/mp4" />
                </video>
                <figcaption>Animación · {d.title}</figcaption>
              </figure>
            )}
            {d.gallery.map((g) => (
              <figure class="gal-item">
                <Image src={g.image} alt={g.alt} widths={[600, 1000, 1500]} sizes="(max-width: 760px) 100vw, 50vw" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {d.results && (
      <section class="section p-results" aria-labelledby="res-title">
        <div class="container p-grid">
          <h2 id="res-title" class="h2">Resultados</h2>
          <p class="lead">{d.results}</p>
        </div>
      </section>
    )}
  </article>

  {related.length > 0 && (
    <section class="section related" aria-labelledby="rel-title">
      <div class="container">
        <h2 id="rel-title" class="h2 rel-title">Proyectos relacionados</h2>
        <div class="rel-grid">
          {related.map((p) => <ProjectCard project={p} sizes="(max-width: 760px) 100vw, 33vw" />)}
        </div>
      </div>
    </section>
  )}

  <ClosingCta title="¿Tienes un proyecto similar?" text="Conversemos sobre lo que quieres lograr y cómo podemos ayudarte." button="Hablemos de tu proyecto" />
</Base>

<style>
  .review-box { background: #fff8dc; border-bottom: 1px solid #f0d77a; padding: 1.25rem 0; font-size: 0.9rem; color: #4d3800; }
  .review-box p { margin: 0 0 0.5rem; }
  .review-box ul { padding-left: 1.2rem; }
  .pending-field { font-size: 0.85rem; color: #6b4e00; background: #fff8dc; border: 1px dashed #f0d77a; padding: 0.5rem 0.75rem; display: inline-block; }

  .p-hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem); }
  .crumbs { font-size: 0.85rem; color: var(--muted); margin-bottom: 2rem; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--blue-text); }
  .p-head { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem 4rem; align-items: end; margin-bottom: 3rem; }
  .p-title { overflow-wrap: anywhere; }
  .p-head .lead { margin: 0; }
  .p-facts { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border-top: 1px solid var(--line); }
  .p-facts div { padding: 1.1rem 1.5rem 0 0; }
  .p-facts dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.35rem; }
  .p-facts dd { margin: 0; font-weight: 500; color: var(--ink); }
  .p-cover :global(img) { width: 100%; max-height: 82vh; object-fit: contain; border-radius: var(--radius); background: var(--bg-soft); }

  .p-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 3rem; }
  .p-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 1rem; padding-top: 1rem; border-top: 2px solid var(--ink); }
  .p-services { list-style: none; }
  .p-services li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); }
  .p-content:not(:empty) { margin-top: 3rem; max-width: 46rem; }

  .gal-title { margin-bottom: 2.5rem; }
  .gal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; align-items: start; }
  .gal-item { margin: 0; background: #fff; border-radius: var(--radius); overflow: hidden; }
  .gal-item :global(img) { width: 100%; }
  .gal-video { grid-row: span 2; background: var(--ink); }
  .gal-video video { width: 100%; max-height: 80vh; margin-inline: auto; }
  .gal-video figcaption { color: rgba(255, 255, 255, 0.7); font-size: 0.8rem; padding: 0.75rem 1rem; }

  .rel-title { margin-bottom: 2.5rem; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }

  @media (max-width: 860px) {
    .p-head, .p-grid { grid-template-columns: 1fr; }
    .p-facts { grid-template-columns: 1fr; }
    .p-facts div { padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
    .rel-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) { .gal-grid, .rel-grid { grid-template-columns: 1fr; } .gal-video { grid-row: auto; } }
</style>
