---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { getProjects, getClients, DISCIPLINE_LABELS, SECTOR_LABELS } from '../../lib/content';

const projects = await getProjects();
const clients = await getClients();
const filters = [{ key: 'todos', label: 'Todos' }, ...Object.entries(DISCIPLINE_LABELS).map(([key, label]) => ({ key, label }))];
const sectorFilters = [{ key: 'todos', label: 'Todos' }, ...Object.entries(SECTOR_LABELS).map(([key, label]) => ({ key, label }))];
---
<Base
  title="Proyectos"
  description="Proyectos de Update Group para marcas, entidades gubernamentales y organizaciones en Puerto Rico: branding, redes sociales, audiovisual, websites, campañas y eventos."
>
  <section class="page-hero">
    <div class="container ph-grid">
      <div>
        <p class="eyebrow">Proyectos</p>
        <h1 class="display">Trabajo real, <span class="grad-text">para públicos reales.</span></h1>
      </div>
      <p class="lead">Una selección de proyectos para marcas comerciales, entidades gubernamentales y organizaciones sin fines de lucro.</p>
    </div>
  </section>

  <section class="section portfolio" aria-labelledby="pf-title">
    <div class="container">
      <h2 id="pf-title" class="sr-only">Portafolio</h2>
      {projects.length > 0 ? (
        <Fragment>
          <div class="filters" role="group" aria-label="Filtrar proyectos por disciplina" data-filter-group="projects" hidden>
            {filters.map((f, i) => (
              <button type="button" class="filter" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
            ))}
          </div>
          <p class="sr-only" aria-live="polite" data-filter-status></p>
          <div class="pf-grid" data-filter-target="projects">
            {projects.map((p, i) => (
              <div class={`pf-item ${i % 5 === 0 ? 'pf-item--wide' : ''}`} data-tags={p.data.disciplines.join(' ')}>
                <ProjectCard project={p} ratio={i % 5 === 0 ? '16 / 9' : '4 / 5'} sizes={i % 5 === 0 ? '(max-width: 760px) 100vw, 66vw' : '(max-width: 760px) 100vw, 33vw'} />
              </div>
            ))}
          </div>
          <p class="pf-empty muted" data-filter-empty hidden>Todavía no hay proyectos publicados en esta categoría.</p>
        </Fragment>
      ) : (
        <div class="pf-none">
          <p class="lead">Estamos preparando los casos de estudio para esta sección. Mientras tanto, puedes ver piezas recientes en nuestro Instagram o escribirnos para conversar sobre tu proyecto.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section--soft" id="clientes" aria-labelledby="cl-title">
    <div class="container">
      <div class="cl-head">
        <div>
          <p class="eyebrow">Clientes</p>
          <h2 id="cl-title" class="h2">Marcas e instituciones con las que hemos trabajado.</h2>
        </div>
        <p class="muted cl-note">Organizaciones con las que hemos colaborado en distintos momentos desde {2020}. La lista no implica un endoso ni una relación vigente.</p>
      </div>
      <div class="filters" role="group" aria-label="Filtrar clientes por sector" data-filter-group="clients" hidden>
        {sectorFilters.map((f, i) => (
          <button type="button" class="filter" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
      <ul class="cl-list" role="list" data-filter-target="clients">
        {clients.map((c) => (
          <li class="cl-item" data-tags={c.data.sector}>
            <div class="cl-logo">
              {c.data.logo ? (
                <Image src={c.data.logo} alt="" height={100} densities={[1, 2]} />
              ) : (
                c.data.abbr ? <span class="cl-initials condensed" aria-hidden="true">{c.data.abbr}</span> : <span class="cl-mark" aria-hidden="true"></span>
              )}
            </div>
            <div>
              <p class="cl-name">{c.data.name}</p>
              <p class="tag">{SECTOR_LABELS[c.data.sector]}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ClosingCta title="¿Tienes un proyecto en mente?" text="Cuéntanos qué quieres lograr y preparamos una propuesta a la medida." />
</Base>

<style>
  .page-hero { padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(2rem, 5vw, 4rem); }
  .ph-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem 4rem; align-items: end; }
  @media (max-width: 860px) { .ph-grid { grid-template-columns: 1fr; } }

  .portfolio { padding-top: clamp(1rem, 3vw, 2rem); }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 3rem; }
  .filter {
    min-height: 44px; padding: 0.55rem 1.15rem; border-radius: 999px; border: 1px solid var(--line); background: #fff;
    font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .filter:hover { border-color: var(--ink); }
  .filter[aria-pressed='true'] { background: var(--ink); color: #fff; border-color: var(--ink); }

  .pf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2.5vw, 2rem); }
  .pf-item--wide { grid-column: span 2; }
  .pf-item[hidden] { display: none; }
  @media (max-width: 900px) { .pf-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .pf-grid { grid-template-columns: 1fr; } .pf-item--wide { grid-column: auto; } }
  .pf-empty { padding: 2rem 0; }
  .pf-none { max-width: 46rem; padding: 2rem 0; }

  .cl-head { display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem 4rem; align-items: end; margin-bottom: 2.5rem; }
  .cl-note { font-size: 0.9rem; margin: 0; }
  @media (max-width: 860px) { .cl-head { grid-template-columns: 1fr; } }
  .cl-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .cl-item { display: grid; grid-template-columns: 96px 1fr; gap: 1.1rem; align-items: center; padding: 1.25rem; background: #fff; }
  .cl-item[hidden] { display: none; }
  .cl-logo { display: grid; place-items: center; width: 96px; height: 64px; }
  .cl-logo :global(img) { max-height: 56px; max-width: 96px; width: auto; height: auto; object-fit: contain; }
  .cl-mark { width: 2.5rem; height: 2px; background: var(--grad); }
  .cl-initials { font-size: 1.6rem; color: var(--ink); letter-spacing: 0.04em; }
  .cl-name { margin: 0 0 0.15rem; font-weight: 600; color: var(--ink); line-height: 1.3; font-size: 0.97rem; }
  .cl-item .tag { margin: 0; }
</style>

<script>
  // Filtros accesibles. Sin JavaScript, todo el contenido queda visible.
  document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
    const name = group.dataset.filterGroup!;
    const target = document.querySelector<HTMLElement>(`[data-filter-target="${name}"]`);
    if (!target) return;
    group.hidden = false;
    const items = [...target.children] as HTMLElement[];
    const status = name === 'projects' ? document.querySelector<HTMLElement>('[data-filter-status]') : null;
    const empty = name === 'projects' ? document.querySelector<HTMLElement>('[data-filter-empty]') : null;
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter!;
      group.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((it) => {
        const match = key === 'todos' || (it.dataset.tags ?? '').split(' ').includes(key);
        it.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = `${shown} ${shown === 1 ? 'proyecto' : 'proyectos'}`;
    });
  });
</script>
