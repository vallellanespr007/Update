---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Página no encontrada" description="La página que buscas no existe o cambió de dirección." noindex>
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Error 404</p>
      <h1 class="display">Esta página <span class="grad-text">se actualizó.</span></h1>
      <p class="lead" style="margin:1.5rem 0 2.25rem">La dirección que buscas no existe o cambió. Estas secciones pueden ayudarte:</p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem 2rem">
        <a href="/" class="link-arrow">Inicio <Arrow size={13} /></a>
        <a href="/servicios/" class="link-arrow">Servicios <Arrow size={13} /></a>
        <a href="/proyectos/" class="link-arrow">Proyectos <Arrow size={13} /></a>
        <a href="/contacto/" class="link-arrow">Contacto <Arrow size={13} /></a>
      </div>
    </div>
  </section>
</Base>
