---
// Página de confirmación para envíos sin JavaScript: Netlify redirige aquí solo después de recibir el formulario.
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Consulta recibida" description="Gracias por escribir a Update Group." noindex>
  <section class="section">
    <div class="container" style="max-width:760px">
      <p class="eyebrow">Contacto</p>
      <h1 class="h2">Recibimos tu consulta.</h1>
      <p class="lead" style="margin:1.5rem 0 2rem">Gracias por escribirnos. Nos comunicaremos contigo pronto.</p>
      <a href="/" class="link-arrow">Volver al inicio <Arrow size={13} /></a>
    </div>
  </section>
</Base>
