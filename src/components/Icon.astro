---
interface Props { name: 'instagram' | 'facebook' | 'whatsapp'; size?: number }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {name === 'instagram' && (
    <Fragment>
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" />
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7" />
      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
    </Fragment>
  )}
  {name === 'facebook' && (
    <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z" fill="currentColor" />
  )}
  {name === 'whatsapp' && (
    <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm0 1.7a7.3 7.3 0 1 1-3.7 13.6l-.3-.2-2.7.7.7-2.6-.2-.3A7.3 7.3 0 0 1 12 4.7Zm-3 3.6c-.2 0-.5 0-.7.3-.3.3-1 .9-1 2.2s1 2.6 1.1 2.8c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4l-.5-.3-1.7-.8c-.3-.1-.5-.1-.6.1l-.8 1c-.2.2-.3.2-.6.1a6 6 0 0 1-3-2.6c-.2-.4.2-.4.7-1.3l.1-.4-.1-.3-.8-1.9c-.2-.5-.4-.4-.5-.4H9Z" fill="currentColor" />
  )}
</svg>
