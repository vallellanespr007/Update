---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-update-group.png';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { t } from '../i18n/ui';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: t('nav.home') },
  { href: '/servicios/', label: t('nav.services') },
  { href: '/proyectos/', label: t('nav.projects') },
  { href: '/nosotros/', label: t('nav.about') },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Update Group — Inicio">
      <Image src={logo} alt="Update Group" width={300} widths={[150, 300]} sizes="150px" class="brand-logo" loading="eager" />
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/contacto/" class="btn btn--sm header-cta">{t('cta.talk')} <Arrow size={14} /></a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only" data-menu-label>{t('a11y.menu')}</span>
      <span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Principal (móvil)">
      <ul>
        {links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              <span class="mm-num condensed">0{i + 1}</span>{l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mm-foot">
      <a href="/contacto/" class="btn">{t('cta.talk')} <Arrow size={14} /></a>
      <a href={site.social.instagram.url} class="mm-ig" target="_blank" rel="noopener">
        <Icon name="instagram" /> {site.social.instagram.handle}<span class="sr-only"> (abre en una pestaña nueva)</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 100; height: var(--header-h);
    background: rgba(255, 255, 255, 0.86); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent; transition: border-color 0.3s, transform 0.4s var(--ease);
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  .site-header.is-hidden { transform: translateY(-100%); }
  .header-inner { height: 100%; display: flex; align-items: center; gap: 2rem; }
  .brand { flex: none; display: block; }
  .brand-logo { width: 150px; height: auto; }
  .nav-desktop { margin-left: auto; }
  .nav-desktop ul { display: flex; gap: 2.2rem; list-style: none; }
  .nav-desktop a {
    text-decoration: none; font-size: 0.95rem; font-weight: 500; color: var(--text); padding: 0.4rem 0; position: relative;
  }
  .nav-desktop a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--grad);
    transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease);
  }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current='page']::after { transform: scaleX(1); }
  .menu-toggle { display: none; }
  .mobile-menu { display: none; }

  @media (max-width: 960px) {
    .site-header { --header-h: 68px; height: 68px; }
    .nav-desktop, .header-cta { display: none; }
    .brand-logo { width: 128px; }
    .menu-toggle {
      display: grid; place-items: center; margin-left: auto; width: 48px; height: 48px; border: 0; background: transparent; cursor: pointer;
    }
    .menu-bars { display: grid; gap: 7px; width: 26px; }
    .menu-bars span { height: 2px; background: var(--ink); transition: transform 0.35s var(--ease); }
    [aria-expanded='true'] .menu-bars span:first-child { transform: translateY(4.5px) rotate(45deg); }
    [aria-expanded='true'] .menu-bars span:last-child { transform: translateY(-4.5px) rotate(-45deg); }

    .mobile-menu {
      display: flex; flex-direction: column; justify-content: space-between;
      position: fixed; top: 68px; left: 0; right: 0; height: calc(100dvh - 68px);
      background: #fff; padding: 2rem var(--gutter) 2.5rem; overflow-y: auto;
    }
    .mobile-menu[hidden] { display: none; }
    .mobile-menu ul { list-style: none; }
    .mobile-menu li { border-bottom: 1px solid var(--line); animation: mm-in 0.5s var(--ease) both; animation-delay: calc(var(--i) * 50ms); }
    .mobile-menu li a {
      display: flex; align-items: baseline; gap: 1rem; padding: 1.1rem 0;
      font-size: 1.9rem; font-weight: 600; letter-spacing: -0.03em; text-decoration: none; color: var(--ink);
    }
    .mobile-menu a[aria-current='page'] { color: var(--blue-text); }
    .mm-num { font-size: 0.95rem; color: var(--muted); }
    .mm-foot { display: grid; gap: 1.25rem; margin-top: 2rem; }
    .mm-ig { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 500; text-decoration: none; justify-self: center; }
  }
  @keyframes mm-in { from { opacity: 0; transform: translateY(10px); } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    header.classList.remove('is-hidden');
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
  });
  matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && setOpen(false));

  header.addEventListener('focusin', () => header.classList.remove('is-hidden'));

  // Encabezado discreto: se oculta al bajar y reaparece al subir.
  let lastY = scrollY;
  addEventListener('scroll', () => {
    const y = scrollY;
    header.classList.toggle('is-scrolled', y > 8);
    if (menu.hidden) header.classList.toggle('is-hidden', y > lastY && y > 400);
    lastY = y;
  }, { passive: true });
</script>
