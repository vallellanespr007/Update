---
import Arrow from './Arrow.astro';
interface Props { title?: string; text?: string; button?: string; href?: string }
const {
  title = 'Tu próximo paso comienza con una conversación.',
  text = 'Cuéntanos qué quieres lograr. Trabajemos en cómo hacerlo realidad.',
  button = 'Solicita una propuesta',
  href = '/contacto/',
} = Astro.props;
---
<section class="section section--dark cta" aria-labelledby="cta-title">
  <svg class="cta-arrow" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs><linearGradient id="cta-g" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0066ff"/><stop offset=".45" stop-color="#00c2ff"/><stop offset=".75" stop-color="#00e0c2"/><stop offset="1" stop-color="#7cf55a"/></linearGradient></defs>
    <path d="M10 190 L150 50 M70 40 H160 V130" stroke="url(#cta-g)" stroke-width="14" fill="none" stroke-linecap="square" />
  </svg>
  <div class="container cta-inner">
    <h2 id="cta-title" class="display cta-title">{title}</h2>
    <div class="cta-side">
      <p class="lead">{text}</p>
      <a href={href} class="btn btn--light">{button} <Arrow size={14} /></a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; }
  .cta-arrow { position: absolute; right: -2%; top: 50%; width: min(42vw, 520px); transform: translateY(-50%); opacity: 0.16; }
  .cta-inner { position: relative; display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem 5rem; align-items: end; }
  .cta-title { font-size: clamp(2.2rem, 1.2rem + 4vw, 4.6rem); }
  .cta-side .lead { margin-bottom: 2rem; }
  @media (max-width: 860px) { .cta-inner { grid-template-columns: 1fr; } .cta-arrow { width: 70vw; top: 20%; } }
</style>
