---
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import site from '../data/site.json';
const ig = site.social.instagram;
// Para mostrar las publicaciones recientes: crear un feed gratuito en behold.so
// conectado a @updategrouppr y pegar el Feed ID en src/data/site.json → instagramFeedId.
const feedId = site.instagramFeedId;
---
<section class="section ig" aria-labelledby="ig-title">
  <div class="container">
    <div class="ig-grid">
      <div>
        <p class="eyebrow">Síguenos en Instagram</p>
        <h2 id="ig-title" class="ig-handle">
          <a href={ig.url} target="_blank" rel="noopener">{ig.handle}<span class="sr-only"> (abre Instagram en una pestaña nueva)</span></a>
        </h2>
      </div>
      <div class="ig-copy">
        <p class="lead">Piezas recientes, producciones y lo que estamos trabajando ahora mismo.</p>
        <a href={ig.url} class="btn" target="_blank" rel="noopener">
          <Icon name="instagram" size={18} /> Ver perfil en Instagram <Arrow size={14} />
        </a>
      </div>
    </div>
    {feedId && (
      <div class="ig-feed">
        <script type="module" src="https://w.behold.so/widget.js" is:inline></script>
        <behold-widget feed-id={feedId}></behold-widget>
      </div>
    )}
  </div>
</section>

<style>
  .ig { border-top: 1px solid var(--line); }
  .ig-grid { display: grid; grid-template-columns: 1fr auto; gap: 2rem 4rem; align-items: end; }
  .ig-grid > div:first-child { grid-column: 1 / -1; }
  .ig-copy { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; }
  .ig-handle { font-size: clamp(2.1rem, 9.2vw, 7.5rem); letter-spacing: -0.045em; line-height: 1.05; white-space: nowrap; }
  .ig-handle a {
    text-decoration: none; background: var(--grad) left bottom / 100% 4px no-repeat; padding-bottom: 0.12em;
    transition: color 0.3s;
  }
  .ig-handle a:hover { color: var(--blue-text); }
  .ig-copy { margin-top: 1rem; }
  .ig-copy .lead { margin: 0; max-width: 40ch; }
  .ig-feed { margin-top: 3.5rem; }
  
</style>
