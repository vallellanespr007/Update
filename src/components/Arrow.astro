---
// Flecha diagonal: recurso de dirección y avance derivado del símbolo.
interface Props { size?: number; class?: string }
const { size = 16, class: cls = '' } = Astro.props;
---
<svg class:list={['arrow', cls]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
  <path d="M4 12 12 4M5.5 4H12v6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
</svg>
